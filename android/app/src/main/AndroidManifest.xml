<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet for API/Socket -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera for QR scan / product photos -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Image & Video picker -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
                     android:maxSdkVersion="32" />
    <!-- Google Play 사진·동영상 권한 정책: 갤러리는 시스템 사진 선택기(image_picker)로만 — 권한 없이 동작.
         플러그인이 끼워 넣어도 빠지게 remove. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove" />
    <!-- v1.0.209: Agora 화면 공유(mediaProjection)는 쓰지 않는다 — Play 포그라운드 서비스 선언 대상에서 뺀다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" tools:node="remove" />

    <!-- Voice call (WebRTC) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ : 마이크 사용 foreground service type 별도 권한 필수 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 통화 중 백그라운드/잠금화면에서도 음성 끊기지 않게 phone-call type 도 보유 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ★★★ 3차 푸시 — flutter_callkit_incoming 백그라운드 통화 수신 -->
    <!-- 앱이 종료/백그라운드 상태일 때 전화 수신 UI 띄우기 위해 필요 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 동네 인증 GPS (정확한 좌표는 검증 직후 폐기, DB 미저장) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:label="Eggplant"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true">

        <!-- v1.0.209: Agora 화면 공유 구성요소 제거 (안 쓰는 기능, mediaProjection 포그라운드 서비스). -->
        <service
            android:name="io.agora.rtc2.extensions.MediaProjectionMgr$LocalScreenSharingService"
            tools:node="remove" />
        <activity
            android:name="io.agora.rtc2.extensions.MediaProjectionMgr$LocalScreenCaptureAssistantActivity"
            tools:node="remove" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link: eggplant://{userId}/{nickname} -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="eggplant" />
            </intent-filter>

            <!-- ★ 5차 푸시 핫픽스: FCM 알림 탭 → MainActivity 인텐트 라우팅.
                 서버(workers-server/src/utils/fcm.ts)가 보낸
                 click_action: 'FLUTTER_NOTIFICATION_CLICK' 와 매칭되어,
                 Android 가 알림 탭 시 이 액티비티로 인텐트를 보내고
                 firebase_messaging plugin 이 onMessageOpenedApp 이벤트를 발생시킴.
                 → PushService._handleOpenedFromPush → router.push('/chat/<roomId>') -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 코인트립 지도 (Google Maps SDK for Android). google-services.json 의 Android 키와 같은 키 —
             Cloud Console 에서 이 키의 API 제한에 Maps SDK for Android 를 추가해 두었다 (2026-10-18). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCmgMgg1q5A0703f-1IEapEUu3LVzO0Dj4" />

        <!-- 코인트립 블랙코인 꽝 보상형 광고 (Google AdMob). 지금은 구글 테스트 앱 ID —
             AdMob 에서 가지 앱을 등록하고 받은 앱 ID(ca-app-pub-…~…)로 바꿔야 실제 광고·수익이 나온다. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <!-- QR 스캔 바코드 모델 (v1.0.209 useUnbundled): 설치할 때 Play 서비스가 미리 받아 둔다. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="barcode" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- 거래 약속 미리 알림 (flutter_local_notifications 예약 알림 · 재부팅 후 복원). -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false" />
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- ★ flutter_callkit_incoming 시스템 통화 UI 컴포넌트 (자동 등록되지만
             명시적으로 권한/스타일을 잡아주기 위해 적음). -->

        <!-- Agora 통화 중 백그라운드 음성 끊김 방지용 Foreground Service.
             flutter_foreground_task 가 자체 서비스를 등록하지만, Android 14+
             FOREGROUND_SERVICE_TYPE_MICROPHONE 명시 필요. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="microphone|phoneCall"
            android:exported="false"
            tools:replace="android:foregroundServiceType" />

        <!-- ============================================================
             v1.0.142 Native call components (QRChat v4.0.270 port)
             Q3=생략 + Agora flow 단순화 적용
             ============================================================ -->

        <!-- Native 수신 통화 풀스크린 Activity (FSI target).
             잠금화면 위에 자체 UI 그림 (FLAG_SHOW_WHEN_LOCKED).
             수락 시 즉시 AgoraCallActivity 직행 (Q3=생략, NativeAccept 게이트 제거). -->
        <activity
            android:name=".NativeIncomingCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />

        <!-- Native 통화 화면 Activity (Agora RTC).
             수신 수락 / 발신 통화 모두 이 Activity 가 처리.
             백그라운드/잠금화면에서도 통화 유지. -->
        <activity
            android:name=".AgoraCallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:excludeFromRecents="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode" />

        <!-- Native 통화 진행 중 Foreground Service.
             AudioFocus + WakeLock + Watchdog (마이크 끊김 방지).
             foregroundServiceType: microphone|phoneCall — Android 14+ 필수. -->
        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone|phoneCall" />

        <!-- FCM 수신 처리 — 3-route 분기 (foreground / unlocked / locked).
             FlutterFirebaseMessagingService 상속하여 일반 채팅 푸시는 기존
             firebase_messaging plugin 으로 위임, incoming_call/call_cancel 만
             native 처리. -->
        <service
            android:name=".EggplantFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 알림 액션 BroadcastReceiver (REJECT only).
             ACTION_REJECT_CALL → MainActivity 로 reject_call_from_native=true 전달. -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.eggplant.market.ACTION_REJECT_CALL" />
            </intent-filter>
        </receiver>

        <!-- Ongoing 알림 "End call" 버튼 BroadcastReceiver.
             CallForegroundService.ACTION_END_CALL → MainActivity 로
             end_call_from_notification=true 전달. -->
        <receiver
            android:name=".CallEndFromNotificationReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.eggplant.market.ACTION_END_CALL_FROM_NOTIFICATION" />
            </intent-filter>
        </receiver>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- 지갑 인증: 블록 탐색기(scan.quantarium.io)를 브라우저로 연다 (url_launcher). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
